################################################################################
# CASO DE USO 1: Detección de PowerShell (T1059.001)
# Estándar Sysmon (XML):
# index=* EventCode=1 (Image="*powershell.exe" OR Image="*pwsh.exe") | table _time, host, User, Image, CommandLine
#
# Adaptación para Dataset CSV (Laboratorio):
################################################################################
index=sysmon_attack powershell 
| table _time, host, EventID, CommandLine, User
| sort - _time


################################################################################
# CASO DE USO 2: Persistencia en Registro (T1547.001)
# Estándar Sysmon (XML):
# index=* (EventCode=12 OR EventCode=13) TargetObject="*\\CurrentVersion\\Run*" | table _time, host, User, Image, TargetObject
#
# Adaptación para Dataset CSV (Laboratorio):
################################################################################
index=sysmon_attack (EventCode=13 OR *CurrentVersion\Run* OR *Registry*)
| table _time, host, EventID, TargetObject, Details, User
| sort - _time


################################################################################
# CASO DE USO 3: Conexiones de Red Sospechosas de Procesos Críticos (T1071)
# Estándar Sysmon (XML):
# index=* EventCode=3 (Image="*powershell.exe" OR Image="*cmd.exe" OR Image="*rundll32.exe") | table _time, host, User, Image, DestinationIp, DestinationPort
#
# Adaptación para Dataset CSV (Laboratorio):
################################################################################
index=sysmon_attack (EventCode=3 OR EventID=3) (powershell OR cmd OR rundll32)
| table _time, host, EventID, Image, DestinationIp, DestinationPort, User
| sort - _time
